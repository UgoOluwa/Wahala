# Wahala — environment reference. Copy to .env.local for local work.
# Everything here is optional: with none of it set the app runs on an in-memory
# store and addresses its SMS fallback to 112.

# --- Storage -----------------------------------------------------------------
# Unset, the store is in-memory. That is fine for one local process and wrong
# for any serverless deployment, where a report filed on one instance is
# invisible to the response desk running on another.
#
# Either backend works; the app picks whichever credentials it finds.

# Redis Cloud, or anything else speaking the Redis protocol. This is what
# Vercel's marketplace provisions.
REDIS_URL=

# Upstash, over HTTP. Preferred on serverless when available.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- SMS fallback ------------------------------------------------------------
# Where a queued report is addressed when there is GSM signal but no data.
# Unset means 112, Nigeria's real emergency line — correct for production, and
# wrong for any deployment people will tap to try it out. Point it at a phone
# you own before demoing.
NEXT_PUBLIC_SMS_SHORTCODE=
